#!/usr/bin/env bash
set -euo pipefail

bundle_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
editor="$bundle_root/libexec/rust-workbench"
analyzer="$bundle_root/libexec/rust-analyzer"
toolchain="$bundle_root/toolchain"
native="$bundle_root/native"

export RUST_WORKBENCH_BUNDLE_ROOT="$bundle_root"
export RUST_WORKBENCH_RUST_ANALYZER="$analyzer"
export RUST_WORKBENCH_RUSTC="$toolchain/bin/rustc"
export RUST_WORKBENCH_RUSTDOC="$toolchain/bin/rustdoc"
export RUST_WORKBENCH_CARGO="$toolchain/bin/cargo"
export RUST_WORKBENCH_RUST_SRC="$toolchain/lib/rustlib/src/rust/library"
export RUSTUP_AUTO_INSTALL=0
unset RUSTUP_TOOLCHAIN RUSTC_BOOTSTRAP || true

export PATH="$toolchain/bin:$native/bin:$bundle_root/libexec:$PATH"
export LD_LIBRARY_PATH="$bundle_root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CC="$native/bin/cc"
export CXX="$native/bin/c++"
export AR="$native/bin/ar"
export RANLIB="$native/bin/ranlib"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$native/bin/cc"

if [[ -n "${RUST_WORKBENCH_DATA_DIR:-}" ]]; then
  data_home="$(mkdir -p "$RUST_WORKBENCH_DATA_DIR" && cd "$RUST_WORKBENCH_DATA_DIR" && pwd -P)"
else
  data_base="${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}"
  data_home="$data_base/rust-workbench"
fi

export CARGO_HOME="${CARGO_HOME:-$data_home/cargo}"
export ZED_UPDATE_EXPLANATION="Rust Workbench is updated by replacing this relocatable bundle."
export ZED_RELEASE_CHANNEL=dev
export ZED_GENERATE_MINIDUMPS=1
unset ZED_MINIDUMP_ENDPOINT || true
mkdir -p "$CARGO_HOME"

doctor() {
  local failed=0
  local required_glibc="2.43"
  local arch
  arch="$(uname -m)"
  echo "Rust Workbench bundle: $bundle_root"
  echo "Architecture: $arch (required: x86_64)"
  if [[ "$arch" != "x86_64" ]]; then
    failed=1
  fi

  local glibc_line glibc_version
  glibc_line="$(getconf GNU_LIBC_VERSION 2>/dev/null || true)"
  glibc_version="${glibc_line#glibc }"
  echo "GLIBC: ${glibc_version:-not found} (required: >= $required_glibc)"
  if [[ -z "$glibc_version" ]] || [[ "$(printf '%s\n%s\n' "$required_glibc" "$glibc_version" | sort -V | head -n1)" != "$required_glibc" ]]; then
    failed=1
  fi

  local component
  for component in "$editor" "$analyzer" "$toolchain/bin/rustc" "$toolchain/bin/cargo" "$native/bin/cc"; do
    if [[ -x "$component" ]]; then
      echo "OK executable: $component"
    else
      echo "MISSING executable: $component" >&2
      failed=1
    fi
  done

  if command -v ldd >/dev/null 2>&1; then
    local missing
    missing="$(ldd "$editor" 2>&1 | grep 'not found' || true)"
    if [[ -n "$missing" ]]; then
      echo "$missing" >&2
      failed=1
    else
      echo "OK shared-library closure"
    fi
  fi
  if command -v sha256sum >/dev/null 2>&1 && [[ -f "$bundle_root/checksums.sha256" ]]; then
    if (cd "$bundle_root" && sha256sum --check --quiet checksums.sha256); then
      echo "OK packaged component checksums"
    else
      echo "FAILED packaged component checksums" >&2
      failed=1
    fi
  else
    echo "MISSING sha256sum or bundle checksum manifest" >&2
    failed=1
  fi

  "$toolchain/bin/rustc" -Vv | sed -n '1,3p'
  "$toolchain/bin/cargo" -V
  "$analyzer" --version
  "$native/bin/cc" --version | sed -n '1p'

  if [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "Display: available"
  else
    echo "Display: unavailable (CLI checks work; the editor window needs X11 or Wayland)"
  fi
  if command -v ldconfig >/dev/null 2>&1 && ldconfig -p 2>/dev/null | grep 'libvulkan.so' >/dev/null; then
    echo "Vulkan loader: available"
  else
    echo "Vulkan loader: not detected; a host Vulkan driver is required for the editor window"
  fi
  return "$failed"
}

case "${1:-}" in
  --doctor)
    doctor
    exit $?
    ;;
  --print-bundle-root)
    printf '%s\n' "$bundle_root"
    exit 0
    ;;
  --run-toolchain)
    shift
    if [[ $# -eq 0 ]]; then
      echo "usage: rust-workbench --run-toolchain COMMAND [ARG ...]" >&2
      exit 2
    fi
    exec "$@"
    ;;
esac

instance_name=""
new_instance=0
print_instance_dir=0
editor_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --instance)
      if [[ $# -lt 2 ]]; then
        echo "usage: rust-workbench --instance NAME [PATH ...]" >&2
        exit 2
      fi
      instance_name="$2"
      shift 2
      ;;
    --new-instance)
      new_instance=1
      shift
      ;;
    --print-instance-dir)
      print_instance_dir=1
      shift
      ;;
    *)
      editor_args+=("$1")
      shift
      ;;
  esac
done

if ! command -v flock >/dev/null 2>&1; then
  echo "Rust Workbench needs flock from util-linux for isolated editor instances." >&2
  exit 1
fi
if [[ -n "$instance_name" \
  && ( ! "$instance_name" =~ ^[A-Za-z0-9._-]+$ || "$instance_name" == "." || "$instance_name" == ".." ) ]]; then
  echo "Rust Workbench instance names may contain letters, digits, dot, underscore, and dash, but cannot be '.' or '..'." >&2
  exit 2
fi

mkdir -p "$data_home/instances"
if [[ $new_instance -eq 1 ]]; then
  if [[ -n "$instance_name" ]]; then
    echo "--instance and --new-instance cannot be used together." >&2
    exit 2
  fi
  instance_name="session-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi

acquire_instance() {
  local candidate="$1"
  local candidate_dir
  if [[ "$candidate" == "default" ]]; then
    candidate_dir="$data_home/default"
  else
    candidate_dir="$data_home/instances/$candidate"
  fi
  mkdir -p "$candidate_dir"
  exec {instance_lock_fd}>"$candidate_dir/.instance.lock"
  if ! flock -n "$instance_lock_fd"; then
    exec {instance_lock_fd}>&-
    return 1
  fi
  instance_name="$candidate"
  instance_dir="$candidate_dir"
}

if [[ -n "$instance_name" ]]; then
  if ! acquire_instance "$instance_name"; then
    echo "Rust Workbench instance '$instance_name' is already running." >&2
    exit 1
  fi
else
  for candidate in default instance-{2..16}; do
    if acquire_instance "$candidate"; then
      break
    fi
  done
  if [[ -z "${instance_dir:-}" ]]; then
    echo "Rust Workbench already has 16 active instances; close one or use --new-instance." >&2
    exit 1
  fi
fi

if [[ "$instance_name" != "default" && ! -e "$instance_dir/config/settings.json" ]]; then
  mkdir -p "$instance_dir/config"
  for config_file in settings.json keymap.json; do
    if [[ -f "$data_home/default/config/$config_file" ]]; then
      cp "$data_home/default/config/$config_file" "$instance_dir/config/$config_file"
    fi
  done
fi

export RUST_WORKBENCH_INSTANCE_ID="$instance_name"
export XDG_CACHE_HOME="$instance_dir/cache"
export XDG_CONFIG_HOME="$instance_dir/config"
export XDG_DATA_HOME="$instance_dir/data"
export RUST_WORKBENCH_ANALYSIS_TARGET="$instance_dir/analysis-target"
mkdir -p "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$RUST_WORKBENCH_ANALYSIS_TARGET"

echo "Rust Workbench instance: $instance_name ($instance_dir)"
if [[ $print_instance_dir -eq 1 ]]; then
  printf '%s\n' "$instance_dir"
  exit 0
fi
exec "$editor" --user-data-dir "$instance_dir/zed" "${editor_args[@]}"
