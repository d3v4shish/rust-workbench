[Desktop Entry]
Type=Application
Version=1.0
Name=@APP_NAME@
GenericName=Rust Editor
Comment=Compiler-backed visual Rust ownership learning editor
Exec=rust-workbench %F
Icon=@APP_ID@
Terminal=false
