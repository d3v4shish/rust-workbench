#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"

archive=""
container=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --archive)
      [[ $# -ge 2 ]] || { echo "--archive requires a path" >&2; exit 2; }
      archive="$2"
      shift 2
      ;;
    --container)
      container=1
      shift
      ;;
    *)
      echo "usage: scripts/verify-release [--archive PATH] [--container]" >&2
      exit 2
      ;;
  esac
done

arguments=(test bundle)
[[ -z "$archive" ]] || arguments+=(--archive "$archive")
[[ $container -eq 0 ]] || arguments+=(--container)
./workbench "${arguments[@]}"
