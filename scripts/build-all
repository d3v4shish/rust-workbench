#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"

./workbench bootstrap
./workbench build all
./workbench doctor

printf '\nBuild outputs:\n'
find \
  rust/build \
  rust/src/tools/rust-analyzer/target/release \
  zed-rust/target/release \
  -type f \( \
    -path 'rust/build/*/stage1/bin/rustc' -o \
    -path 'rust/build/*/stage1/bin/rustdoc' -o \
    -path 'rust/src/tools/rust-analyzer/target/release/rust-analyzer' -o \
    -path 'zed-rust/target/release/rust-workbench' \
  \) \
  -printf '%10s  %p\n' | sort
