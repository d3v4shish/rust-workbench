#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"

./workbench bootstrap
./workbench build all
./workbench doctor

printf '\nBuild outputs:\n'
find \
  rust/build/x86_64-unknown-linux-gnu/stage1/bin \
  rust/src/tools/rust-analyzer/target/release \
  zed-rust/target/release \
  -maxdepth 1 -type f \
  \( -name rustc -o -name rustdoc -o -name rust-analyzer -o -name rust-workbench \) \
  -printf '%10s  %p\n' | sort
